{
  "headers": [
    { "source": "/(.*)\\.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }, { "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/(.*)\\.pck", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }, { "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/index.service.worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }, { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }] }
  ]
}
